{
  "name": "aiSarthi",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "test": "bun test apps/backend/tests apps/frontend/tests",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose stop",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "start": "turbo run start"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.11",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.11"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
